<Window x:Class="NovaBoost.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NovaBoost" Height="790" Width="1250"
 MinHeight="680" MinWidth="1000"
 WindowStartupLocation="CenterScreen"
 Background="#0A0B10" Foreground="#F4F4FA"
 FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#13151E"/>
  <SolidColorBrush x:Key="Muted" Color="#9298AA"/>
  <SolidColorBrush x:Key="Accent" Color="#A78BFA"/>
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#A9ADBE"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,13"/>
   <Setter Property="Margin" Value="0,3"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="#8B5CF6"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="17,11"/>
   <Setter Property="Margin" Value="0,5,7,5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}"
       CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center"
        VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
   <Setter Property="Background" Value="#252735"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#E3E5EF"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Margin" Value="0,9"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="225"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Background="#0F1017" BorderBrush="#222431"
   BorderThickness="0,0,1,0" Grid.Column="0">
   <DockPanel Margin="17">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="3,7,0,34">
      <Border Background="#8B5CF6" CornerRadius="10"
       Width="39" Height="39">
       <TextBlock Text="N" FontSize="25" FontWeight="Bold"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="NovaBoost" FontSize="18" FontWeight="Bold"/>
       <TextBlock Text="GAMING EDITION" FontSize="9"
        Foreground="#A78BFA"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="MENU" Foreground="#62687A"
      FontSize="10" Margin="8,0,0,8"/>
     <Button Style="{StaticResource Nav}" Content="◈   Dashboard"
      Click="Dashboard_Click"/>
     <Button Style="{StaticResource Nav}" Content="⚡   FPS Lab"
      Click="FPS_Click"/>
     <Button Style="{StaticResource Nav}" Content="▤   Cleaner"
      Click="Cleaner_Click"/>
     <Button Style="{StaticResource Nav}" Content="◷   Startup Apps"
      Click="Startup_Click"/>
     <Button Style="{StaticResource Nav}" Content="⚙   Settings"
      Click="Settings_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#191522"
     CornerRadius="12" Padding="13" Margin="0,15,0,0">
     <StackPanel>
      <TextBlock Text="✦  FREE &amp; OPEN SOURCE"
       Foreground="#C4B5FD" FontWeight="Bold" FontSize="10"/>
      <TextBlock Text="No subscriptions. No locked features. No fake FPS claims."
       Foreground="#A4A2B5" FontSize="11"
       TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>

  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="30">
    <DockPanel Margin="0,0,0,26">
     <StackPanel>
      <TextBlock x:Name="PageTitle" Text="Dashboard"
       FontSize="28" FontWeight="Bold"/>
      <TextBlock x:Name="PageSubtitle"
       Text="Every frame matters." Foreground="{StaticResource Muted}"
       Margin="0,5,0,0"/>
     </StackPanel>
     <Border Background="#19251F" CornerRadius="8"
      Padding="10,7" VerticalAlignment="Center">
      <TextBlock Text="●  SAFETY MODE" Foreground="#79D9A2"
       FontSize="10" FontWeight="Bold"/>
     </Border>
    </DockPanel>

    <Border Background="#171328" CornerRadius="17"
     Padding="25" Margin="0,0,0,20">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="YOUR PC. YOUR RULES."
        Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
       <TextBlock Text="Make every frame count."
        FontSize="27" FontWeight="Bold" Margin="0,10,0,5"/>
       <TextBlock Text="Practical optimizations. Transparent changes. Always free."
        Foreground="#B7B3CA" TextWrapping="Wrap"/>
       <Button x:Name="AnalyzeButton" Content="Analyze system  →"
        Style="{StaticResource Action}" HorizontalAlignment="Left"
        Margin="0,19,0,0" Click="Optimize_Click"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="⚡" FontSize="65"
       Foreground="#A78BFA" VerticalAlignment="Center" Margin="20,0"/>
     </Grid>
    </Border>

    <UniformGrid Columns="3" Margin="0,0,0,22">
     <Border Background="{StaticResource Panel}" CornerRadius="12"
      Padding="17" Margin="0,0,9,0">
      <StackPanel>
       <TextBlock Text="CPU LOAD" Foreground="#969BAE" FontSize="10"/>
       <TextBlock x:Name="CpuValue" Text="--" FontSize="29"
        FontWeight="Bold" Margin="0,8,0,3"/>
       <ProgressBar x:Name="CpuBar" Height="4" Maximum="100"
        Value="0" Background="#292B39" Foreground="#A78BFA"/>
       <TextBlock Text="Processor utilization" Foreground="#969BAE"
        FontSize="10" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="{StaticResource Panel}" CornerRadius="12"
      Padding="17" Margin="5,0">
      <StackPanel>
       <TextBlock Text="RAM USAGE" Foreground="#969BAE" FontSize="10"/>
       <TextBlock x:Name="RamValue" Text="--" FontSize="29"
        FontWeight="Bold" Margin="0,8,0,3"/>
       <ProgressBar x:Name="RamBar" Height="4" Maximum="100"
        Value="0" Background="#292B39" Foreground="#38BDF8"/>
       <TextBlock x:Name="RamDetail" Text="Physical memory"
        Foreground="#969BAE" FontSize="10" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="{StaticResource Panel}" CornerRadius="12"
      Padding="17" Margin="9,0,0,0">
      <StackPanel>
       <TextBlock Text="POWER PLAN" Foreground="#969BAE" FontSize="10"/>
       <TextBlock x:Name="PowerValue" Text="Checking..."
        FontSize="17" FontWeight="Bold" Margin="0,13,0,8"
        TextWrapping="Wrap"/>
       <TextBlock Text="Windows power configuration"
        Foreground="#969BAE" FontSize="10"/>
      </StackPanel>
     </Border>
    </UniformGrid>

    <TextBlock Text="PERFORMANCE TOOLS" FontSize="17"
     FontWeight="Bold" Margin="0,0,0,12"/>

    <UniformGrid Columns="2">
     <Border Background="{StaticResource Panel}" CornerRadius="13"
      Padding="19" Margin="0,0,9,10">
      <StackPanel>
       <TextBlock Text="⚡  FPS LAB" FontSize="16" FontWeight="Bold"/>
       <TextBlock Text="Gaming mode and power profiles."
        Foreground="#9DA3B5" TextWrapping="Wrap" Margin="0,8,0,12"/>
       <Button Content="Configure gaming" Style="{StaticResource Action}"
        HorizontalAlignment="Left" Click="FPS_Click"/>
      </StackPanel>
     </Border>
     <Border Background="{StaticResource Panel}" CornerRadius="13"
      Padding="19" Margin="5,0,0,10">
      <StackPanel>
       <TextBlock Text="▤  CLEANER" FontSize="16" FontWeight="Bold"/>
       <TextBlock Text="Review temporary files before deleting."
        Foreground="#9DA3B5" TextWrapping="Wrap" Margin="0,8,0,12"/>
       <Button Content="Scan files" Style="{StaticResource Action}"
        HorizontalAlignment="Left" Click="Cleaner_Click"/>
      </StackPanel>
     </Border>
    </UniformGrid>

    <Border Background="{StaticResource Panel}" CornerRadius="13"
     Padding="18" Margin="0,4,0,12">
     <StackPanel>
      <TextBlock Text="QUICK GAMING PROFILE" FontSize="15"
       FontWeight="Bold"/>
      <TextBlock Text="Choose which Windows settings to apply."
       Foreground="#969BAE" Margin="0,5,0,10"/>
      <CheckBox x:Name="GameModeCheck" IsChecked="True"
       Content="Enable Windows Game Mode"/>
      <CheckBox x:Name="HighPowerCheck"
       Content="Use High Performance power plan (may use more electricity)"/>
      <WrapPanel Margin="0,8,0,0">
       <Button Content="Apply selected" Style="{StaticResource Action}"
        Click="ApplyProfile_Click"/>
       <Button Content="Restore saved settings"
        Style="{StaticResource Secondary}" Click="Restore_Click"/>
      </WrapPanel>
      <TextBlock Text="Changes are recorded before applying. Restore uses the saved settings."
       Foreground="#969BAE" FontSize="11" TextWrapping="Wrap"
       Margin="0,7,0,0"/>
     </StackPanel>
    </Border>

    <Border Background="{StaticResource Panel}" CornerRadius="13"
     Padding="17">
     <StackPanel>
      <TextBlock Text="ACTIVITY" FontSize="14" FontWeight="Bold"/>
      <TextBlock x:Name="StatusText"
       Text="Ready. No settings have been changed."
       Foreground="#A4A9BA" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="NOVABOOST • COMMUNITY-DRIVEN • FREE FOREVER"
     Foreground="#606779" FontSize="10" Margin="0,18,0,5"
     HorizontalAlignment="Center"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>


